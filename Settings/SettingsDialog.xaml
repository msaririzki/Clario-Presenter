<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Clario_Presenter.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    AutomationProperties.Name="Pengaturan rekaman"
    FontFamily="{StaticResource ClarioFont}"
    Background="{StaticResource ClarioSurfaceBrush}"
    BorderBrush="{StaticResource ClarioBorderBrush}"
    BorderThickness="1"
    CornerRadius="16"
    Opened="SettingsDialog_Opened"
    Closing="SettingsDialog_Closing"
    Closed="SettingsDialog_Closed">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default" Source="ms-appx:///Themes/ControlBrushes.xaml" />
                <ResourceDictionary x:Key="Light" Source="ms-appx:///Themes/ControlBrushes.xaml" />
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="ContentDialogMaxWidth">1024</x:Double>
            <x:Double x:Key="ContentDialogMinWidth">0</x:Double>
            <Thickness x:Key="ContentDialogPadding">0</Thickness>
            <Thickness x:Key="ContentDialogTitleMargin">0</Thickness>
            <Thickness x:Key="ContentDialogSeparatorThickness">0</Thickness>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#B9B5FF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#D7D5FF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#A9A5F3" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#B9B5FF" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#B9B5FF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#D7D5FF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#D7D5FF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#A9A5F3" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#A9A5F3" />
            <Style x:Key="SettingsSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource ClarioHeadingStyle}">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>
            <Style x:Key="SettingsHint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ClarioSecondaryTextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource ClarioPanelStyle}">
                <Setter Property="Background" Value="{StaticResource ClarioRaisedBrush}" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="SettingsSwitch" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="44" />
                <Setter Property="OnContent" Value="{x:Null}" />
                <Setter Property="OffContent" Value="{x:Null}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <Grid x:Name="SettingsLayout" Background="{StaticResource ClarioSurfaceBrush}" CornerRadius="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="22,15" BorderBrush="{StaticResource ClarioBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource ClarioAccentSoftBrush}"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{StaticResource ClarioPrivateStatusBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Pengaturan" FontSize="22" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="Berlaku untuk rekaman berikutnya" Style="{StaticResource SettingsHint}" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView x:Name="SettingsNavigation" Grid.Row="1" OpenPaneLength="174" PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False" AlwaysShowHeader="False"
                        Background="{StaticResource ClarioCanvasBrush}"
                        AutomationProperties.Name="Kategori pengaturan">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#151922" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#2A313E" />
                <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#0E1116" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#292747" />
                <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#37345A" />
                <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#B9B5FF" />
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CameraNavigationItem" Content="Kamera">
                    <NavigationViewItem.Icon><FontIcon x:Name="CameraNavigationIcon" Glyph="&#xE714;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AudioNavigationItem" Content="Audio">
                    <NavigationViewItem.Icon><FontIcon x:Name="AudioNavigationIcon" Glyph="&#xE767;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="VideoNavigationItem" Content="Video">
                    <NavigationViewItem.Icon><FontIcon x:Name="VideoNavigationIcon" Glyph="&#xE8B2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="StorageNavigationItem" Content="Penyimpanan">
                    <NavigationViewItem.Icon><SymbolIcon x:Name="StorageNavigationIcon" Symbol="Folder" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <Grid Margin="24,20,24,20">
                    <StackPanel x:Name="CameraSection" Spacing="14">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Kamera" Style="{StaticResource SettingsSectionTitle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <TextBlock Text="Aktifkan kamera" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="CameraEnabledToggle" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="Aktifkan kamera" Toggled="CameraEnabled_Changed" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="CameraLayout" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="CameraControlsColumn" Width="0.65*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="CameraPreviewPane" Spacing="8" MaxWidth="442">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Preview rekaman" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock x:Name="CameraPreviewSourceText" Grid.Column="1" Text="Contoh · 16:9" Style="{StaticResource SettingsHint}" />
                                </Grid>
                                <Border BorderThickness="1" BorderBrush="{StaticResource ClarioBorderBrush}" CornerRadius="10"
                                        Background="#0D1018">
                                    <Viewbox Stretch="Uniform">
                                        <Grid x:Name="CameraPreviewFrame" Width="480" Height="270" Background="Transparent"
                                              PointerPressed="CameraPreview_PointerPressed" PointerMoved="CameraPreview_PointerMoved"
                                              PointerReleased="CameraPreview_PointerReleased" PointerCanceled="CameraPreview_PointerReleased"
                                              PointerCaptureLost="CameraPreview_PointerCaptureLost">
                                            <Border Margin="20,19,20,19" CornerRadius="8" BorderThickness="1"
                                                    Background="#131927" BorderBrush="#2A3448">
                                                <Grid Padding="15" RowSpacing="13">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Ellipse Width="6" Height="6" Fill="#807ACC" />
                                                        <Ellipse Width="6" Height="6" Fill="#596582" />
                                                        <Ellipse Width="6" Height="6" Fill="#394662" />
                                                    </StackPanel>
                                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="1.7*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="#1B2436" CornerRadius="5">
                                                            <StackPanel Padding="12,14" Spacing="9">
                                                                <Rectangle Height="6" Width="46" Fill="#526883" RadiusX="3" RadiusY="3" HorizontalAlignment="Left" />
                                                                <Rectangle Height="4" Width="76" Fill="#34435D" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" />
                                                                <Rectangle Height="4" Width="57" Fill="#34435D" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" />
                                                                <Rectangle Height="4" Width="65" Fill="#34435D" RadiusX="2" RadiusY="2" HorizontalAlignment="Left" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Grid.Column="1" Background="#202A3C" CornerRadius="5">
                                                            <FontIcon Glyph="&#xE7F4;" FontSize="38" Foreground="#5A6F8D"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <canvas:CanvasControl x:Name="CameraPreviewCanvas" UseSharedDevice="True" ClearColor="Transparent"
                                                                  Draw="CameraPreviewCanvas_Draw" IsHitTestVisible="False"
                                                                  AutomationProperties.Name="Preview rekaman dan posisi kamera" />
                                            <Canvas IsHitTestVisible="False">
                                                <Border x:Name="CameraPreviewPlaceholder" CornerRadius="5" BorderThickness="1.5"
                                                        Background="#26243E" BorderBrush="#B9B5FF">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" Spacing="5">
                                                        <FontIcon x:Name="CameraPlaceholderIcon" Glyph="&#xE714;" FontSize="12" Foreground="#D7D5FF" />
                                                        <TextBlock x:Name="CameraPlaceholderLabel" Text="Kamera" FontSize="12"
                                                                   FontWeight="SemiBold" Foreground="#ECEAFF" />
                                                    </StackPanel>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="Seret kotak kamera untuk mengatur posisi." Style="{StaticResource SettingsHint}" />
                                <TextBlock x:Name="CameraPreviewDetails" Style="{StaticResource SettingsHint}" />
                                <TextBlock x:Name="CameraStatusText" Style="{StaticResource SettingsHint}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>

                            <StackPanel x:Name="CameraControls" Grid.Column="1" Spacing="7">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CameraDeviceComboBox" Header="Perangkat kamera" Style="{StaticResource ClarioPickerStyle}"
                                              PlaceholderText="Pilih kamera" DisplayMemberPath="Name" SelectionChanged="CameraDevice_SelectionChanged" />
                                    <Button x:Name="RefreshCamerasButton" Grid.Column="1" VerticalAlignment="Bottom"
                                            Style="{StaticResource ClarioIconButtonStyle}" Click="RefreshCameras_Click"
                                            AutomationProperties.Name="Perbarui daftar kamera" ToolTipService.ToolTip="Perbarui daftar kamera">
                                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                    </Button>
                                </Grid>
                                <ComboBox x:Name="CameraPositionComboBox" Header="Posisi di video" Style="{StaticResource ClarioPickerStyle}"
                                          SelectionChanged="CameraLayout_Changed">
                                    <ComboBoxItem Content="Kanan bawah" /><ComboBoxItem Content="Kiri bawah" />
                                    <ComboBoxItem Content="Kanan atas" /><ComboBoxItem Content="Kiri atas" />
                                    <ComboBoxItem x:Name="CameraCustomPositionItem" Content="Kustom" />
                                </ComboBox>
                                <ComboBox x:Name="CameraSizeComboBox" Header="Ukuran kamera" Style="{StaticResource ClarioPickerStyle}"
                                          SelectionChanged="CameraSizePreset_Changed">
                                    <ComboBoxItem Content="Kecil · 18%" Tag="18" />
                                    <ComboBoxItem Content="Sedang · 24%" Tag="24" />
                                    <ComboBoxItem Content="Besar · 30%" Tag="30" />
                                    <ComboBoxItem x:Name="CameraCustomSizeItem" Content="Kustom" />
                                </ComboBox>
                                <StackPanel x:Name="CustomCameraWidthControls" Spacing="4" Visibility="Collapsed">
                                    <Grid ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="CameraWidthSlider" MinWidth="0" VerticalAlignment="Center"
                                                StepFrequency="1" AutomationProperties.Name="Geser lebar kamera dalam persen"
                                                ValueChanged="CameraWidthSlider_Changed" />
                                        <TextBox x:Name="CameraWidthInput" Grid.Column="1" MinWidth="0"
                                                 InputScope="Number" TextAlignment="Center" VerticalAlignment="Center"
                                                 AutomationProperties.Name="Lebar kamera dalam persen" TextChanged="CameraWidthInput_Changed" />
                                        <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="CameraWidthHint" Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <CheckBox x:Name="CameraMirrorCheckBox" Content="Cerminkan gambar" MinWidth="0"
                                          Checked="CameraMirror_Changed" Unchecked="CameraMirror_Changed" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AudioSection" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Audio" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE767;" FontSize="17" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="Suara komputer" FontWeight="SemiBold" />
                                        <TextBlock Text="Termasuk suara aplikasi yang disembunyikan." Style="{StaticResource SettingsHint}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ComputerAudioToggle" Grid.Column="2" Style="{StaticResource SettingsSwitch}"
                                                  AutomationProperties.Name="Rekam suara komputer" Toggled="AudioSource_Changed" />
                                </Grid>
                                <Grid x:Name="PlaybackAudioOptions" Visibility="Collapsed" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PlaybackAudioComboBox" Header="Keluaran suara" DisplayMemberPath="Name"
                                              Style="{StaticResource ClarioPickerStyle}" PlaceholderText="Pilih speaker atau headphone"
                                              ToolTipService.ToolTip="{Binding SelectedItem.Name, ElementName=PlaybackAudioComboBox}"
                                              SelectionChanged="AudioDevice_SelectionChanged" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,3" Spacing="6">
                                        <ProgressBar x:Name="PlaybackLevelBar" Height="6" Maximum="100"
                                                     Foreground="{StaticResource ClarioLiveBrush}" AutomationProperties.Name="Level suara komputer" />
                                        <TextBlock x:Name="PlaybackLevelStatus" Style="{StaticResource SettingsHint}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE720;" FontSize="17" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="Mikrofon" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="MicrophoneAudioToggle" Grid.Column="2" Style="{StaticResource SettingsSwitch}"
                                                  AutomationProperties.Name="Rekam mikrofon" Toggled="AudioSource_Changed" />
                                </Grid>
                                <Grid x:Name="MicrophoneAudioOptions" Visibility="Collapsed" ColumnSpacing="14">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="MicrophoneAudioComboBox" Header="Input mikrofon" DisplayMemberPath="Name"
                                              Style="{StaticResource ClarioPickerStyle}" PlaceholderText="Pilih mikrofon"
                                              ToolTipService.ToolTip="{Binding SelectedItem.Name, ElementName=MicrophoneAudioComboBox}"
                                              SelectionChanged="AudioDevice_SelectionChanged" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,3" Spacing="6">
                                        <ProgressBar x:Name="MicrophoneLevelBar" Height="6" Maximum="100"
                                                     Foreground="{StaticResource ClarioLiveBrush}" AutomationProperties.Name="Level mikrofon" />
                                        <TextBlock x:Name="MicrophoneLevelStatus" Style="{StaticResource SettingsHint}" />
                                    </StackPanel>
                                    <ComboBox Grid.Row="1" Margin="0,10,0,0" x:Name="MicrophoneProfilePicker"
                                              Header="Profil suara mikrofon" Style="{StaticResource ClarioPickerStyle}"
                                              SelectionChanged="AudioDevice_SelectionChanged">
                                        <ComboBoxItem Content="Narasi (Windows)" />
                                        <ComboBoxItem Content="Standar perangkat" />
                                        <ComboBoxItem Content="Narasi hangat" />
                                    </ComboBox>
                                    <ToggleSwitch x:Name="FanNoiseToggle" Grid.Row="1" Grid.Column="1" Header="Redam suara kipas"
                                                  Margin="0,10,0,0" Style="{StaticResource SettingsSwitch}" Toggled="AudioSource_Changed" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="AudioDeviceActions" Visibility="Collapsed" Spacing="6">
                            <Button x:Name="RefreshAudioButton" Content="Perbarui perangkat audio" Click="RefreshAudio_Click"
                                    Style="{StaticResource ClarioButtonStyle}" />
                            <TextBlock x:Name="AudioStatusText" Style="{StaticResource SettingsHint}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="VideoSection" Visibility="Collapsed" Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Video" Style="{StaticResource SettingsSectionTitle}" />
                            <TextBlock Text="Format rekaman · MP4 1080p" Style="{StaticResource SettingsHint}" />
                        </StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="5">
                                    <ComboBox x:Name="FrameRateComboBox" Header="Laju bingkai" Style="{StaticResource ClarioPickerStyle}">
                                        <ComboBoxItem Content="60 fps" Tag="60" />
                                        <ComboBoxItem Content="30 fps" Tag="30" />
                                    </ComboBox>
                                    <TextBlock Text="60 fps lebih halus. 30 fps lebih ringan untuk diproses." Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <ComboBox x:Name="BitrateComboBox" Header="Kualitas video" Style="{StaticResource ClarioPickerStyle}">
                                        <ComboBoxItem Content="Ringan · 10 Mbps" Tag="10" />
                                        <ComboBoxItem Content="Seimbang · 18 Mbps" Tag="18" />
                                        <ComboBoxItem Content="Detail tinggi · 28 Mbps" Tag="28" />
                                    </ComboBox>
                                    <TextBlock Text="Bitrate lebih tinggi menjaga detail dan memperbesar ukuran file." Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="StorageSection" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Penyimpanan" Style="{StaticResource SettingsSectionTitle}" />
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <SymbolIcon Symbol="Folder" Foreground="{StaticResource ClarioPrivateStatusBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="Folder rekaman" FontWeight="SemiBold" />
                                        <TextBlock x:Name="FolderPathText" TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource SettingsHint}" TextWrapping="NoWrap"
                                                   ToolTipService.ToolTip="{Binding Text, ElementName=FolderPathText}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Ganti folder" Style="{StaticResource ClarioButtonStyle}" Click="ChooseFolder_Click" />
                                    <Button Content="Buka folder" Style="{StaticResource ClarioButtonStyle}" Click="OpenFolder_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="Tanya lokasi sebelum merekam" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Saat nonaktif, video disimpan otomatis ke folder di atas." Style="{StaticResource SettingsHint}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AskLocationToggle" Grid.Column="1" Style="{StaticResource SettingsSwitch}"
                                              AutomationProperties.Name="Tanya lokasi sebelum merekam" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource ClarioBorderBrush}" Padding="18,12">
            <StackPanel Spacing="8">
                <TextBlock x:Name="SettingsErrorText" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{StaticResource ClarioRecordingBrush}" FontSize="13" AutomationProperties.LiveSetting="Assertive" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="Batal" MinWidth="78" Style="{StaticResource ClarioButtonStyle}" Click="Cancel_Click" />
                    <Button x:Name="SaveSettingsButton" Content="Simpan" MinWidth="104"
                            Style="{StaticResource ClarioPrimaryButtonStyle}" Click="SaveSettings_Click">
                        <Button.Resources>
                            <SolidColorBrush x:Key="AccentButtonBackground" Color="#C7C5FF" />
                            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#D7D5FF" />
                            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A9A5F3" />
                        </Button.Resources>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="S" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
