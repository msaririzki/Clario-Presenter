<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Clario_Presenter.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="Pengaturan"
    PrimaryButtonText="Simpan"
    CloseButtonText="Batal"
    DefaultButton="Primary"
    Opened="SettingsDialog_Opened"
    Closing="SettingsDialog_Closing"
    Closed="SettingsDialog_Closed"
    PrimaryButtonClick="SettingsDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default" Source="ms-appx:///Themes/ControlBrushes.xaml" />
                <ResourceDictionary x:Key="Light" Source="ms-appx:///Themes/ControlBrushes.xaml" />
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
        </ResourceDictionary>
    </ContentDialog.Resources>

    <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="540" Padding="0,0,8,0" Spacing="18">
        <StackPanel Spacing="7">
            <TextBlock Text="Kamera" Style="{StaticResource ClarioHeadingStyle}" />
            <ToggleSwitch x:Name="CameraEnabledToggle" Header="Sertakan kamera dalam video" OffContent="Mati" OnContent="Aktif"
                          Toggled="CameraEnabled_Changed" />
            <TextBlock Text="Gambar kamera muncul di video yang disimpan." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
        </StackPanel>

        <Border x:Name="CameraOptionsPanel" Visibility="Collapsed" Padding="12" Style="{StaticResource ClarioPanelStyle}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="CameraDeviceComboBox" Header="Pilih kamera" Style="{StaticResource ClarioPickerStyle}" DisplayMemberPath="Name" AutomationProperties.Name="Pilih kamera" />
                    <Button x:Name="RefreshCamerasButton" Grid.Column="1" Content="Perbarui daftar" VerticalAlignment="Bottom" Style="{StaticResource ClarioButtonStyle}" Click="RefreshCameras_Click" />
                </Grid>
                <TextBlock Text="Hubungkan webcam atau aktifkan kamera virtual, lalu perbarui daftar." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="CameraPositionComboBox" Header="Posisi di video" Style="{StaticResource ClarioPickerStyle}" AutomationProperties.Name="Posisi kamera di video">
                        <ComboBoxItem Content="Kanan bawah" /><ComboBoxItem Content="Kiri bawah" />
                        <ComboBoxItem Content="Kanan atas" /><ComboBoxItem Content="Kiri atas" />
                    </ComboBox>
                    <ComboBox x:Name="CameraSizeComboBox" Grid.Column="1" Header="Ukuran kamera" Style="{StaticResource ClarioPickerStyle}" AutomationProperties.Name="Ukuran kamera">
                        <ComboBoxItem Content="Kecil · 18%" /><ComboBoxItem Content="Sedang · 24%" /><ComboBoxItem Content="Besar · 30%" />
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="CameraMirrorCheckBox" Content="Cerminkan gambar kamera" Checked="CameraMirror_Changed" Unchecked="CameraMirror_Changed" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Height="135" Background="{StaticResource ClarioCanvasBrush}" CornerRadius="8">
                        <Grid>
                            <canvas:CanvasControl x:Name="CameraPreviewCanvas" UseSharedDevice="True" ClearColor="#0E1116" Draw="CameraPreviewCanvas_Draw" />
                            <TextBlock x:Name="CameraPreviewPlaceholder" Text="Pratinjau kamera" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="TestCameraButton" Content="Tes kamera" Style="{StaticResource ClarioButtonStyle}" Click="TestCamera_Click" />
                        <TextBlock x:Name="CameraStatusText" Text="Kamera belum dinyalakan." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Spacing="8">
            <TextBlock Text="Audio" Style="{StaticResource ClarioHeadingStyle}" />
            <ToggleSwitch x:Name="ComputerAudioToggle" Header="Suara komputer" OffContent="Mati" OnContent="Aktif"
                          Toggled="AudioSource_Changed" />
            <StackPanel x:Name="ComputerAudioOptions" Visibility="Collapsed" Spacing="6">
                <ComboBox x:Name="PlaybackAudioComboBox" Header="Keluaran suara" DisplayMemberPath="Name"
                          Style="{StaticResource ClarioPickerStyle}" PlaceholderText="Pilih speaker atau headphone"
                          SelectionChanged="AudioDevice_SelectionChanged" />
                <TextBlock Text="Semua suara dari keluaran yang dipilih ikut terekam, termasuk dari aplikasi tersembunyi."
                           TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
            </StackPanel>
            <ToggleSwitch x:Name="MicrophoneAudioToggle" Header="Mikrofon" OffContent="Mati" OnContent="Aktif"
                          Toggled="AudioSource_Changed" />
            <ComboBox x:Name="MicrophoneAudioComboBox" Header="Input mikrofon" DisplayMemberPath="Name" Visibility="Collapsed"
                      Style="{StaticResource ClarioPickerStyle}" PlaceholderText="Pilih mikrofon laptop, USB, atau mixer"
                      SelectionChanged="AudioDevice_SelectionChanged" />
            <StackPanel x:Name="AudioDeviceActions" Visibility="Collapsed" Spacing="4">
                <Button x:Name="RefreshAudioButton" Content="Perbarui perangkat audio" Click="RefreshAudio_Click"
                        Style="{StaticResource ClarioButtonStyle}" />
                <TextBlock x:Name="AudioStatusText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource ClarioSecondaryTextBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="SettingsErrorText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource ClarioPrivacyBrush}" FontSize="12" />
        <StackPanel Spacing="4">
            <TextBlock Text="Video" Style="{StaticResource ClarioHeadingStyle}" />
            <TextBlock Text="Rekaman berikutnya · MP4 1080p" FontSize="12" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
        </StackPanel>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <ComboBox x:Name="FrameRateComboBox" Header="Kelancaran" Style="{StaticResource ClarioPickerStyle}">
                    <ComboBoxItem Content="60 fps · lebih halus" Tag="60" />
                    <ComboBoxItem Content="30 fps · lebih ringan" Tag="30" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <ComboBox x:Name="BitrateComboBox" Header="Kualitas" Style="{StaticResource ClarioPickerStyle}">
                    <ComboBoxItem Content="Ringan · 10 Mbps" Tag="10" />
                    <ComboBoxItem Content="Seimbang · 18 Mbps" Tag="18" />
                    <ComboBoxItem Content="Detail tinggi · 28 Mbps" Tag="28" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Spacing="8">
            <TextBlock Text="Penyimpanan" Style="{StaticResource ClarioHeadingStyle}" />
            <Border Padding="10,8" CornerRadius="8" Background="{StaticResource ClarioRaisedBrush}">
                <TextBlock x:Name="FolderPathText" TextTrimming="CharacterEllipsis" FontSize="12"
                           Foreground="{StaticResource ClarioSecondaryTextBrush}" ToolTipService.ToolTip="{Binding Text, ElementName=FolderPathText}" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Buka folder" Style="{StaticResource ClarioButtonStyle}" Click="OpenFolder_Click" />
                <Button Content="Ganti folder" Style="{StaticResource ClarioButtonStyle}" Click="ChooseFolder_Click" />
            </StackPanel>
            <ToggleSwitch x:Name="AskLocationToggle" Header="Tanya lokasi setiap kali merekam"
                          OffContent="Simpan otomatis" OnContent="Pilih sebelum merekam" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</ContentDialog>
