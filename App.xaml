<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Clario_Presenter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="ClarioFont">Segoe UI Variable Text</FontFamily>
            <SolidColorBrush x:Key="ClarioCanvasBrush" Color="#0E1116" />
            <SolidColorBrush x:Key="ClarioSurfaceBrush" Color="#151922" />
            <SolidColorBrush x:Key="ClarioRaisedBrush" Color="#1B202A" />
            <SolidColorBrush x:Key="ClarioSubtleBrush" Color="#202631" />
            <SolidColorBrush x:Key="ClarioBorderBrush" Color="#2A313E" />
            <SolidColorBrush x:Key="ClarioTextBrush" Color="#F3F5F8" />
            <SolidColorBrush x:Key="ClarioSecondaryTextBrush" Color="#9CA7B7" />
            <SolidColorBrush x:Key="ClarioAccentBrush" Color="#817BE8" />
            <SolidColorBrush x:Key="ClarioAccentSoftBrush" Color="#292747" />
            <SolidColorBrush x:Key="ClarioLiveBrush" Color="#49C49A" />
            <SolidColorBrush x:Key="ClarioLiveSoftBrush" Color="#15372F" />
            <SolidColorBrush x:Key="ClarioFreezeBrush" Color="#E9B85B" />
            <SolidColorBrush x:Key="ClarioFreezeSoftBrush" Color="#3A2E19" />
            <SolidColorBrush x:Key="ClarioPrivacyBrush" Color="#EC6A7E" />
            <SolidColorBrush x:Key="ClarioPrivacySoftBrush" Color="#3D2028" />

            <Style TargetType="Page">
                <Setter Property="FontFamily" Value="{StaticResource ClarioFont}" />
                <Setter Property="Foreground" Value="{StaticResource ClarioTextBrush}" />
                <Setter Property="Background" Value="{StaticResource ClarioCanvasBrush}" />
            </Style>
            <Style x:Key="ClarioPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ClarioSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ClarioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="ClarioButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource ClarioRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ClarioTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ClarioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="ClarioPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ClarioButtonStyle}">
                <Setter Property="Background" Value="{StaticResource ClarioTextBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ClarioCanvasBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="ClarioIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ClarioButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="ClarioToggleStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{StaticResource ClarioRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ClarioTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource ClarioBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="ClarioSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ClarioSecondaryTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="90" />
            </Style>
            <Style x:Key="ClarioHeadingStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ClarioTextBrush}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
