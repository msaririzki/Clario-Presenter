<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Clario_Presenter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clario Presenter">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource ClarioCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{StaticResource ClarioSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="26" Height="26" Margin="16,0,10,0" CornerRadius="7" Background="{StaticResource ClarioAccentBrush}">
                <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="White" />
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Clario" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="Presenter" FontSize="14" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,148,0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Ellipse x:Name="TitleStatusDot" Width="7" Height="7" Fill="{StaticResource ClarioSecondaryTextBrush}" />
                <TextBlock x:Name="TitleStatusText" Text="Siap" FontSize="12" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
            </StackPanel>
        </Grid>
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
