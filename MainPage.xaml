<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Clario_Presenter.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="#F3F5F8" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#E4E8EE" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#CDD5E1" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#262D37" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0E1116" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0E1116" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0E1116" />
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#AAB4C2" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="AccentButtonForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{ThemeResource SystemColorButtonTextColor}" />
                    <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{StaticResource ClarioCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource ClarioSurfaceBrush}" BorderBrush="{StaticResource ClarioBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="20,14" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="138" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SessionModeComboBox" Header="Mode" SelectedIndex="0" MinHeight="38" HorizontalAlignment="Stretch"
                              SelectionChanged="SessionModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Rekam" />
                        <ComboBoxItem Content="Presentasi" />
                    </ComboBox>
                    <ComboBox x:Name="CaptureModeComboBox" Grid.Column="1" Header="Sumber" SelectedIndex="1" MinHeight="38" HorizontalAlignment="Stretch"
                              SelectionChanged="CaptureModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Aplikasi" />
                        <ComboBoxItem Content="Layar" />
                    </ComboBox>

                    <Grid Grid.Column="2" MaxWidth="620" HorizontalAlignment="Left" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SourceMonitorComboBox" Header="Pilih layar" MinWidth="140" MinHeight="38" HorizontalAlignment="Stretch"
                                  DisplayMemberPath="ShortDisplayName" DropDownOpened="DisplayComboBox_DropDownOpened" SelectionChanged="SourceMonitorComboBox_SelectionChanged" />
                        <ComboBox x:Name="SourceComboBox" Header="Pilih aplikasi" MinWidth="140" MinHeight="38" HorizontalAlignment="Stretch"
                                  Visibility="Collapsed" DisplayMemberPath="DisplayName" SelectionChanged="SourceComboBox_SelectionChanged" />
                        <Button x:Name="RefreshSourcesButton" Grid.Column="1" VerticalAlignment="Bottom" Visibility="Collapsed"
                                Style="{StaticResource ClarioIconButtonStyle}" AutomationProperties.Name="Perbarui daftar aplikasi"
                                ToolTipService.ToolTip="Perbarui daftar aplikasi" Click="RefreshSources_Click">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <Button x:Name="PrimaryButton" Grid.Column="3" Content="Mulai rekam" MinHeight="38" MinWidth="124" VerticalAlignment="Bottom"
                            Style="{StaticResource ClarioPrimaryButtonStyle}" Click="PrimaryButton_Click" />
                </Grid>

                <StackPanel x:Name="OutputOptions" Grid.Row="1" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
                    <ComboBox x:Name="DisplayComboBox" Header="Layar audiens" Width="174" MinHeight="36" DisplayMemberPath="ShortDisplayName"
                              DropDownOpened="DisplayComboBox_DropDownOpened" />
                    <ComboBox x:Name="OutputScaleComboBox" Header="Ukuran gambar" Width="164" MinHeight="36" SelectedIndex="1">
                        <ComboBoxItem Content="Perbesar" ToolTipService.ToolTip="Perbesar gambar. Sebagian tepi dapat terpotong." />
                        <ComboBoxItem Content="Seluruh gambar" ToolTipService.ToolTip="Tampilkan gambar secara utuh." />
                        <ComboBoxItem Content="Isi layar" ToolTipService.ToolTip="Penuhi area tampilan. Sebagian tepi dapat terpotong." />
                    </ComboBox>
                </StackPanel>

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PrivateAppsButton" Content="Sembunyikan aplikasi" Style="{StaticResource ClarioButtonStyle}"
                                ToolTipService.ToolTip="Pilih jendela yang tidak boleh terlihat dalam rekaman atau presentasi." Click="PrivateAppsButton_Click" />
                        <ToggleButton x:Name="NotesButton" Content="Catatan" AutomationProperties.Name="Catatan" Style="{StaticResource ClarioToggleStyle}" Click="NotesButton_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PreviewButton" Content="Lihat pratinjau" Style="{StaticResource ClarioButtonStyle}" Click="PreviewButton_Click" />
                        <Button x:Name="SettingsButton" Content="Pengaturan" Style="{StaticResource ClarioButtonStyle}" Click="SettingsButton_Click"
                                ToolTipService.ToolTip="Atur kamera, kualitas video, dan folder penyimpanan." />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="StudioGrid" Grid.Row="1" Padding="20,16" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="NotesColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ClarioPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid MinHeight="54" Padding="14,8" ColumnSpacing="12" BorderBrush="{StaticResource ClarioBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Pratinjau" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="ActiveSourceTitle" FontSize="12" Foreground="{StaticResource ClarioSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel x:Name="SessionControls" Grid.Column="1" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <ToggleButton x:Name="FreezeButton" Content="Freeze" Style="{StaticResource ClarioToggleStyle}"
                                          ToolTipService.ToolTip="Tahan gambar terakhir. Klik lagi untuk melanjutkan." Click="FreezeButton_Click" />
                            <ToggleButton x:Name="PrivacyButton" Content="Privasi" Style="{StaticResource ClarioToggleStyle}"
                                          ToolTipService.ToolTip="Tutup tampilan sementara. Klik lagi untuk menampilkannya." Click="PrivacyButton_Click" />
                            <Button x:Name="RecordButton" Content="Rekam" Style="{StaticResource ClarioButtonStyle}"
                                    ToolTipService.ToolTip="Simpan juga presentasi sebagai video." Click="RecordButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="8" Background="{StaticResource ClarioCanvasBrush}">
                        <canvas:CanvasControl x:Name="LivePreviewCanvas" Visibility="Collapsed" UseSharedDevice="True"
                                              ClearColor="#0E1116" Draw="LivePreviewCanvas_Draw" />
                        <StackPanel x:Name="ClientStateOverlay" MaxWidth="340" Margin="18" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource ClarioRaisedBrush}" Margin="0,0,0,4">
                                <FontIcon x:Name="ClientStateIcon" Glyph="&#xE7F4;" FontSize="20" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                            </Border>
                            <TextBlock x:Name="ClientStateTitle" Text="Siap merekam" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="ClientStateSubtitle" Text="Tampilan yang masuk ke video akan terlihat di sini." FontSize="13"
                                       Foreground="{StaticResource ClarioSecondaryTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="NotesPanel" Grid.Column="1" Padding="14" Style="{StaticResource ClarioPanelStyle}" Visibility="Collapsed">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Catatan pribadi" Style="{StaticResource ClarioHeadingStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource ClarioIconButtonStyle}" AutomationProperties.Name="Tutup editor catatan"
                                Click="CollapseNotes_Click" ToolTipService.ToolTip="Tutup editor catatan">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <TextBox Grid.Row="1" x:Name="FreeNotesTextBox" MinHeight="80" MaxLength="32000" AcceptsReturn="True" TextWrapping="Wrap"
                             AutomationProperties.Name="Teks catatan" PlaceholderText="Ketik atau tempel catatan di sini…" TextChanged="FreeNotesTextBox_TextChanged" />
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="OpenNotesButton" Content="Buka file" Click="OpenNotes_Click" HorizontalAlignment="Stretch"
                                    Style="{StaticResource ClarioButtonStyle}" ToolTipService.ToolTip="Buka file catatan .md atau .txt" />
                            <Button x:Name="PinNotesButton" Grid.Column="1" Content="Sematkan" Click="PinNotes_Click" HorizontalAlignment="Stretch"
                                    Style="{StaticResource ClarioPrimaryButtonStyle}" ToolTipService.ToolTip="Tampilkan catatan di atas aplikasi lain" />
                        </Grid>
                        <Button Content="Atur catatan" Style="{StaticResource ClarioButtonStyle}">
                            <Button.Flyout>
                                <Flyout Opening="NoteOptions_Opening">
                                    <StackPanel Width="265" Spacing="8">
                                        <CheckBox x:Name="MarkdownNotesCheckBox" Content="Gunakan format Markdown" Checked="MarkdownNotes_Changed" Unchecked="MarkdownNotes_Changed"
                                                  ToolTipService.ToolTip="Judul dengan ## menjadi langkah terpisah. Letakkan perintah di blok kode." />
                                        <ComboBox x:Name="NotesMonitorComboBox" Header="Layar catatan" DisplayMemberPath="DisplayName"
                                                  HorizontalAlignment="Stretch" SelectionChanged="NoteAppearance_Changed" />
                                        <ToggleSwitch x:Name="NotesClickThroughToggle" Header="Klik tembus" IsOn="True" OnContent="Klik masuk ke aplikasi di belakang" OffContent="Catatan bisa digeser" Toggled="NoteAppearance_Changed" />
                                        <Slider x:Name="NotesOpacitySlider" Header="Opasitas catatan (%)" Minimum="25" Maximum="100" Value="82" StepFrequency="5" ValueChanged="NoteAppearance_Changed" />
                                        <Slider x:Name="NotesFontSizeSlider" Header="Ukuran teks" Minimum="12" Maximum="26" Value="16" StepFrequency="1" ValueChanged="NoteAppearance_Changed" />
                                        <Slider x:Name="NotesWidthSlider" Header="Ukuran panel" Minimum="320" Maximum="760" Value="440" StepFrequency="20" ValueChanged="NoteAppearance_Changed" />
                                        <TextBlock Text="Ctrl+Shift+F8: tampil atau sembunyi&#xA;Ctrl+Shift+F9: ubah Klik tembus&#xA;Ctrl+Shift+F10 / F11: pindah langkah&#xA;Ctrl+Shift+↑ / ↓: gulir langkah" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock x:Name="NoteStatusText" Text="" TextWrapping="Wrap"
                                   FontSize="11" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="20,0" Background="{StaticResource ClarioSurfaceBrush}">
            <Grid ColumnSpacing="7" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon x:Name="FooterStatusIcon" Glyph="&#xE930;" FontSize="11" Foreground="{StaticResource ClarioLiveBrush}" />
                <TextBlock x:Name="FooterStatusText" Grid.Column="1" Text="Pilih layar atau aplikasi untuk memulai" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource ClarioSecondaryTextBrush}" ToolTipService.ToolTip="{Binding Text, ElementName=FooterStatusText}" />
            </Grid>
        </Grid>
    </Grid>
</Page>
