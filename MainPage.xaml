<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Clario_Presenter.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource ClarioCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,12" Background="{StaticResource ClarioSurfaceBrush}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0" Spacing="5">
                <TextBlock Text="PILIH TAMPILAN" Style="{StaticResource ClarioSectionLabelStyle}" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="178" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="CaptureModeComboBox" MinHeight="38" SelectedIndex="1" AutomationProperties.Name="Jenis tampilan" SelectionChanged="CaptureModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Satu aplikasi" Tag="Window" ToolTipService.ToolTip="Tampilkan atau rekam satu jendela aplikasi yang dipilih." />
                        <ComboBoxItem Content="Layar terlindungi" Tag="SafeMirror" ToolTipService.ToolTip="Tampilkan atau rekam satu layar sambil menyembunyikan aplikasi tertentu." />
                    </ComboBox>
                    <ComboBox x:Name="SourceComboBox" Grid.Column="1" Margin="6,0,0,0" MinHeight="38" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" AutomationProperties.Name="Aplikasi yang ditampilkan" SelectionChanged="SourceComboBox_SelectionChanged" />
                    <ComboBox x:Name="SourceMonitorComboBox" Grid.Column="1" Margin="6,0,0,0" MinHeight="38" HorizontalAlignment="Stretch" Visibility="Collapsed" DisplayMemberPath="DisplayName" AutomationProperties.Name="Layar yang direkam" ToolTipService.ToolTip="Pilih layar yang akan direkam atau ditampilkan kepada audiens." DropDownOpened="DisplayComboBox_DropDownOpened" SelectionChanged="SourceMonitorComboBox_SelectionChanged" />
                    <Button Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource ClarioIconButtonStyle}" AutomationProperties.Name="Perbarui daftar aplikasi" ToolTipService.ToolTip="Perbarui daftar aplikasi yang terbuka" Click="RefreshSources_Click">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0" Spacing="5">
                <Grid>
                    <TextBlock Text="LAYAR AUDIENS" Style="{StaticResource ClarioSectionLabelStyle}" VerticalAlignment="Center" />
                    <CheckBox x:Name="RecordingOnlyCheckBox" Content="Rekam saja" MinHeight="20" FontSize="11" HorizontalAlignment="Right" Checked="RecordingOnly_Changed" Unchecked="RecordingOnly_Changed" ToolTipService.ToolTip="Simpan video tanpa menampilkan presentasi di layar lain. Layar kedua tetap bebas digunakan." />
                </Grid>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="148" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="DisplayComboBox" MinHeight="38" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayName" AutomationProperties.Name="Layar untuk audiens" DropDownOpened="DisplayComboBox_DropDownOpened" />
                    <ComboBox x:Name="OutputScaleComboBox" Grid.Column="1" MinHeight="38" SelectedIndex="1" AutomationProperties.Name="Ukuran tampilan" ToolTipService.ToolTip="Seluruh layar menampilkan semua bagian gambar tanpa memotong tepinya.">
                        <ComboBoxItem Content="Perbesar" Tag="Adaptive" ToolTipService.ToolTip="Perbesar tampilan agar lebih mudah dibaca. Sebagian tepi gambar dapat terpotong." />
                        <ComboBoxItem Content="Seluruh layar" Tag="Fit" ToolTipService.ToolTip="Tampilkan seluruh gambar tanpa memotong bagian mana pun." />
                        <ComboBoxItem Content="Penuhi layar" Tag="Fill" ToolTipService.ToolTip="Penuhi layar tujuan. Sebagian gambar dapat terpotong jika bentuk kedua layar berbeda." />
                    </ComboBox>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="PrivateAppsButton" Style="{StaticResource ClarioButtonStyle}" AutomationProperties.Name="Pilih aplikasi yang disembunyikan" ToolTipService.ToolTip="Pilih jendela aplikasi yang tidak boleh terlihat oleh audiens atau masuk rekaman. Pilih sebelum memulai sesi." Click="PrivateAppsButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE72E;" FontSize="13" /><TextBlock x:Name="PrivateAppsButtonText" Text="Sembunyikan (0)" /></StackPanel>
                </Button>
                <ToggleButton x:Name="FreezeButton" Style="{StaticResource ClarioToggleStyle}" AutomationProperties.Name="Tahan gambar terakhir" ToolTipService.ToolTip="Tahan gambar terakhir saat Anda membuka aplikasi lain. Klik lagi untuk melanjutkan gambar." Click="FreezeButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE768;" FontSize="13" /><TextBlock Text="Tahan gambar" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="PrivacyButton" Style="{StaticResource ClarioToggleStyle}" AutomationProperties.Name="Tampilkan layar jeda" ToolTipService.ToolTip="Ganti gambar dengan pesan Presentasi dijeda. Rekaman tetap berjalan. Klik lagi untuk kembali." Click="PrivacyButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE890;" FontSize="13" /><TextBlock Text="Layar jeda" /></StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="NotesButton" IsChecked="True" Style="{StaticResource ClarioToggleStyle}" AutomationProperties.Name="Tampilkan catatan" Click="NotesButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE70B;" FontSize="13" /><TextBlock Text="Catatan" /></StackPanel>
                </ToggleButton>
                <Button x:Name="SettingsButton" Style="{StaticResource ClarioIconButtonStyle}" AutomationProperties.Name="Buka pengaturan" Click="SettingsButton_Click" ToolTipService.ToolTip="Pengaturan kamera, kualitas video, dan penyimpanan">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
                <ToggleButton x:Name="RecordButton" MinWidth="112" IsEnabled="False" Style="{StaticResource ClarioToggleStyle}" AutomationProperties.Name="Mulai atau akhiri rekaman" Click="RecordButton_Click" ToolTipService.ToolTip="Mulai merekam tampilan yang dipilih. Saat merekam, klik Selesai untuk menyimpan video.">
                    <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse x:Name="RecordButtonDot" Width="7" Height="7" Fill="{StaticResource ClarioPrivacyBrush}" /><TextBlock x:Name="RecordButtonText" Text="Rekam" /></StackPanel>
                </ToggleButton>
                <Button x:Name="LiveButton" MinWidth="104" Style="{StaticResource ClarioPrimaryButtonStyle}" AutomationProperties.Name="Mulai atau akhiri sesi" Click="LiveButton_Click" ToolTipService.ToolTip="Mulai menampilkan presentasi atau siapkan layar untuk direkam. Tekan Rekam untuk mulai menyimpan video.">
                    <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="LiveButtonDot" Width="7" Height="7" Fill="{StaticResource ClarioPrivacyBrush}" /><TextBlock x:Name="LiveButtonText" Text="Mulai presentasi" /></StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="StudioGrid" Grid.Row="1" Padding="16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="NotesColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ClarioPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="15,0" BorderBrush="{StaticResource ClarioBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="ActiveSourceTitle" Text="Pilih layar atau aplikasi" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ActiveSourceSubtitle" Text="Hanya tampilan yang dipilih yang terlihat oleh audiens dan masuk rekaman" FontSize="11" Foreground="{StaticResource ClarioSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="9,4" CornerRadius="12" Background="{StaticResource ClarioLiveSoftBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="6" Height="6" Fill="{StaticResource ClarioLiveBrush}" /><TextBlock x:Name="SourcePrivacyBadgeText" Text="SATU APLIKASI" FontSize="10" CharacterSpacing="70" Foreground="{StaticResource ClarioLiveBrush}" /></StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" Margin="12" Background="{StaticResource ClarioCanvasBrush}">
                        <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Padding="10,0" Background="{StaticResource ClarioRaisedBrush}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#505765" /><Ellipse Width="7" Height="7" Fill="#505765" /><Ellipse Width="7" Height="7" Fill="#505765" /></StackPanel>
                            <Border Grid.Column="1" MaxWidth="500" Height="25" Padding="10,0" CornerRadius="6" Background="{StaticResource ClarioSurfaceBrush}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><FontIcon Glyph="&#xE72E;" FontSize="10" Foreground="{StaticResource ClarioSecondaryTextBrush}" /><TextBlock x:Name="BrowserAddressText" Text="Pratinjau tampilan" FontSize="10" Foreground="{StaticResource ClarioSecondaryTextBrush}" /></StackPanel>
                            </Border>
                            <FontIcon Grid.Column="2" Glyph="&#xE712;" FontSize="13" Foreground="{StaticResource ClarioSecondaryTextBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Padding="0,16" Spacing="16" Background="{StaticResource ClarioSurfaceBrush}" HorizontalAlignment="Stretch">
                                <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource ClarioAccentBrush}" HorizontalAlignment="Center"><TextBlock Text="N" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource ClarioAccentSoftBrush}" HorizontalAlignment="Center"><FontIcon Glyph="&#xE80F;" FontSize="14" Foreground="{StaticResource ClarioAccentBrush}" /></Border>
                                <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                                <FontIcon Glyph="&#xE9D2;" FontSize="14" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                                <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                            </StackPanel>

                            <Grid Grid.Column="1" Padding="24,20">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4"><TextBlock Text="RINGKASAN" Style="{StaticResource ClarioSectionLabelStyle}" /><TextBlock x:Name="DemoHeadingText" Text="Selamat pagi, Andi" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                                    <Button Grid.Column="1" Content="Buat laporan" Style="{StaticResource ClarioButtonStyle}" VerticalAlignment="Bottom" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,20,0,12" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Padding="15" Style="{StaticResource ClarioPanelStyle}"><StackPanel Spacing="8"><TextBlock Text="Proyek aktif" FontSize="11" Foreground="{StaticResource ClarioSecondaryTextBrush}" /><TextBlock Text="24" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="+4 bulan ini" FontSize="10" Foreground="{StaticResource ClarioLiveBrush}" /></StackPanel></Border>
                                    <Border Grid.Column="1" Padding="15" Style="{StaticResource ClarioPanelStyle}"><StackPanel Spacing="8"><TextBlock Text="Klien baru" FontSize="11" Foreground="{StaticResource ClarioSecondaryTextBrush}" /><TextBlock Text="18" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="+12,5%" FontSize="10" Foreground="{StaticResource ClarioLiveBrush}" /></StackPanel></Border>
                                    <Border Grid.Column="2" Padding="15" Style="{StaticResource ClarioPanelStyle}"><StackPanel Spacing="8"><TextBlock Text="Kemajuan" FontSize="11" Foreground="{StaticResource ClarioSecondaryTextBrush}" /><TextBlock Text="78%" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="Tepat jadwal" FontSize="10" Foreground="{StaticResource ClarioLiveBrush}" /></StackPanel></Border>
                                </Grid>
                                <Border Grid.Row="2" Padding="16" Style="{StaticResource ClarioPanelStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid><TextBlock Text="Aktivitas proyek" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="84 proyek" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource ClarioSecondaryTextBrush}" /></Grid>
                                        <Viewbox Grid.Row="1" Stretch="Fill" Margin="0,16,0,0">
                                            <Canvas Width="760" Height="190">
                                                <Line X1="0" Y1="45" X2="760" Y2="45" Stroke="{StaticResource ClarioBorderBrush}" /><Line X1="0" Y1="95" X2="760" Y2="95" Stroke="{StaticResource ClarioBorderBrush}" /><Line X1="0" Y1="145" X2="760" Y2="145" Stroke="{StaticResource ClarioBorderBrush}" />
                                                <Polyline Points="0,160 85,145 160,128 245,116 330,92 410,102 500,65 590,72 675,35 760,28" Stroke="{StaticResource ClarioAccentBrush}" StrokeThickness="3" StrokeLineJoin="Round" Fill="Transparent" />
                                                <Ellipse Canvas.Left="752" Canvas.Top="20" Width="16" Height="16" Fill="{StaticResource ClarioSurfaceBrush}" Stroke="{StaticResource ClarioAccentBrush}" StrokeThickness="3" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <canvas:CanvasControl x:Name="LivePreviewCanvas" Grid.RowSpan="2" Visibility="Collapsed" UseSharedDevice="True" ClearColor="#0E1116" Draw="LivePreviewCanvas_Draw" />

                        <Border Grid.RowSpan="2" Width="214" Height="132" Margin="18" Padding="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" CornerRadius="10" Background="{StaticResource ClarioRaisedBrush}" BorderBrush="{StaticResource ClarioBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="25" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE7F4;" FontSize="11" /><TextBlock x:Name="ClientPreviewLabel" Text="Tampilan audiens" FontSize="10" /></StackPanel><TextBlock x:Name="ClientStatusText" Text="SIAP" HorizontalAlignment="Right" FontSize="9" CharacterSpacing="80" Foreground="{StaticResource ClarioSecondaryTextBrush}" /></Grid>
                                <Border Grid.Row="1" Background="{StaticResource ClarioCanvasBrush}" CornerRadius="5">
                                    <Grid>
                                        <Grid x:Name="MiniOutputContent" Margin="10">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="8" /><RowDefinition Height="8" /></Grid.RowDefinitions>
                                            <TextBlock x:Name="MiniOutputTitle" Text="Selamat pagi, Andi" FontSize="9" FontWeight="SemiBold" /><Border Grid.Row="1" Margin="0,7,0,0" CornerRadius="2" Background="{StaticResource ClarioAccentSoftBrush}" /><Border Grid.Row="2" Width="120" Margin="0,7,0,0" CornerRadius="2" Background="{StaticResource ClarioAccentSoftBrush}" HorizontalAlignment="Left" /><Border Grid.Row="3" Width="80" Margin="0,7,0,0" CornerRadius="2" Background="{StaticResource ClarioAccentSoftBrush}" HorizontalAlignment="Left" />
                                        </Grid>
                                        <Grid x:Name="ClientStateOverlay" Visibility="Collapsed" Background="#E6111419">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3"><FontIcon x:Name="ClientStateIcon" Glyph="&#xE890;" FontSize="15" HorizontalAlignment="Center" /><TextBlock x:Name="ClientStateTitle" Text="Layar jeda aktif" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock x:Name="ClientStateSubtitle" Text="Gambar tidak ditampilkan" FontSize="8" Foreground="{StaticResource ClarioSecondaryTextBrush}" HorizontalAlignment="Center" /></StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="NotesPanel" Grid.Column="1" Padding="16" Style="{StaticResource ClarioPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE890;" FontSize="11" Foreground="{StaticResource ClarioAccentBrush}" /><TextBlock Text="HANYA UNTUK ANDA" Style="{StaticResource ClarioSectionLabelStyle}" Foreground="{StaticResource ClarioAccentBrush}" /></StackPanel><TextBlock Text="Catatan presenter" Style="{StaticResource ClarioHeadingStyle}" /></StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ClarioIconButtonStyle}" AutomationProperties.Name="Sembunyikan catatan" Click="CollapseNotes_Click" ToolTipService.ToolTip="Sembunyikan catatan"><FontIcon Glyph="&#xE76B;" FontSize="13" /></Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,18,0,14" Padding="0,12" BorderBrush="{StaticResource ClarioBorderBrush}" BorderThickness="0,1,0,1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4"><TextBlock Text="DURASI" Style="{StaticResource ClarioSectionLabelStyle}" /><TextBlock x:Name="TimerText" Text="00:00" FontSize="17" FontWeight="SemiBold" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="BAGIAN" Style="{StaticResource ClarioSectionLabelStyle}" /><TextBlock Text="Demo utama" FontSize="13" FontWeight="SemiBold" /></StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Padding="13" CornerRadius="9" Background="{StaticResource ClarioAccentSoftBrush}">
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="28" Height="28" CornerRadius="7" BorderBrush="{StaticResource ClarioAccentBrush}" BorderThickness="1"><TextBlock Text="03" FontSize="10" Foreground="{StaticResource ClarioAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Tunjukkan alur laporan" FontSize="13" FontWeight="SemiBold" /><TextBlock Text="Tekankan bahwa laporan dibuat otomatis dan dapat diekspor tanpa proses manual." TextWrapping="Wrap" FontSize="11" LineHeight="17" Foreground="{StaticResource ClarioSecondaryTextBrush}" /></StackPanel></Grid>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,15,0,12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="DAFTAR PERIKSA" Style="{StaticResource ClarioSectionLabelStyle}" />
                        <StackPanel Grid.Row="1" Margin="0,10,0,12" Spacing="9"><CheckBox Content="Jelaskan masalah klien" IsChecked="True" /><CheckBox Content="Demo proses login" IsChecked="True" /><CheckBox Content="Buat laporan baru" /><CheckBox Content="Tunjukkan ekspor PDF" /></StackPanel>
                        <StackPanel Grid.Row="2" Spacing="6"><TextBlock Text="CATATAN BEBAS" Style="{StaticResource ClarioSectionLabelStyle}" /><TextBox x:Name="FreeNotesTextBox" MinHeight="96" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Tulis poin yang tidak boleh terlupakan..." /></StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="4" Spacing="9">
                        <Button Style="{StaticResource ClarioButtonStyle}" HorizontalAlignment="Stretch"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7"><FontIcon Glyph="&#xE8A5;" FontSize="13" /><TextBlock Text="Buka PDF referensi" /></StackPanel></Button>
                        <TextBlock Text="Catatan ini hanya tampil di laptop Anda." FontSize="10" TextAlignment="Center" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="16,0" Background="{StaticResource ClarioSurfaceBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0" ColumnSpacing="7" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon x:Name="FooterStatusIcon" Glyph="&#xE930;" FontSize="11" Foreground="{StaticResource ClarioLiveBrush}" />
                <TextBlock x:Name="FooterStatusText" Grid.Column="1" Text="Pilih layar atau aplikasi untuk memulai" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{StaticResource ClarioSecondaryTextBrush}" ToolTipService.ToolTip="{Binding Text, ElementName=FooterStatusText}" />
            </Grid>
            <TextBlock Grid.Column="1" Text="Catatan hanya terlihat oleh Anda" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource ClarioSecondaryTextBrush}" />
        </Grid>
    </Grid>
</Page>
